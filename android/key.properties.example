# Copy this file to android/key.properties and fill in your real passwords.
# NEVER commit key.properties or *.jks to git.
#
# 1) Create a keystore (run once from project root):
#    keytool -genkey -v -keystore android/app/upload-keystore.jks -storetype JKS -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2) Copy this file:
#    copy android\key.properties.example android\key.properties
#
# 3) Edit android/key.properties with your passwords.

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
